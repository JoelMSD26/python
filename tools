#receber dois numeros e receber a operação que quer fazer
num1 = int(input("escreve o primeiro numero: "))
num2 = int(input("escreve o segundo numero: "))
operacao = input("escreve a operação que quer fazer: ")

if (operacao == "+"):
    resultado = num1 + num2
    print("O resultado é: ", resultado)
elif (operacao == "-"):
    resultado = num1 - num2
    print("O resultado é: ", resultado)
elif (operacao == "*"):
    resultado = num1 * num2
    print("O resultado é: ", resultado)
elif (operacao == "/"):
    resultado = num1 / num2
    print("O resultado é: ", resultado)
else:
    print("Operação inválida")

#break 
indice = 10
while (indice > 0):
  resto = indice % 2
  if (resto == 0):
    print("o número %d é par" % (indice))
  else:
    print("o número %d é impar" % (indice))
    break #vai parar no 9 e dps fazer o print que acabou o while
  indice -= 1
print("acabou o while") 

#continue
indice = 10
while (indice > 0 ):
  resto = indice % 2
  if (resto == 0):
    print("o número %d é par" % (indice))
  else:
    indice -= 1
    continue
  indice -= 1
print("acabou o while")
#so vai gerar numeros pares até o resto ser 0


